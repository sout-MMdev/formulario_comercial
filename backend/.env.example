# ==============================================================
# Modelo de variáveis de ambiente — COPIE para .env e preencha.
# NUNCA comitar o .env preenchido (está no .gitignore).
# ==============================================================

# ---- FRONT-END (público — vai pro bundle, pode ser visto por qualquer um) ----
# Só a URL do projeto e a chave PÚBLICA (anon). Nada secreto aqui.
# Pegue os dois em: projeto cativa-crm → Settings → API.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque_a_chave_publica_anon_aqui

# ---- BACK-END (SEGREDO — só nas Edge Functions, nunca no front) ----
# Estes NÃO usam prefixo VITE_ e NÃO podem aparecer em código de front.
# No Supabase, defina com:  supabase secrets set NOME=valor
SUPABASE_SERVICE_ROLE_KEY=segredo_apenas_no_servidor
EMAIL_API_KEY=segredo_apenas_no_servidor
INFOTERA_API_KEY=segredo_apenas_no_servidor
