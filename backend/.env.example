# ================================================================
# Variáveis que os APPS leem (apps/desktop e apps/mobile)
#
# Não precisa preencher à mão: `npm run backend:conectar-apps` cria
# apps/desktop/.env.local e apps/mobile/.env.local com os valores do
# Supabase local, e `npm run backend:desconectar-apps` apaga os dois.
#
# Sem estas variáveis, os apps rodam no MODO DEMONSTRAÇÃO
# (listas fictícias e envio simulado), que é como o site publicado roda.
#
# Nunca versione um .env com valores (o .gitignore já bloqueia).
# ================================================================

# URL da API do Supabase (local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=

# Chave PÚBLICA (publishable). Nunca coloque aqui a chave de serviço:
# ela só existe dentro das Edge Functions.
VITE_SUPABASE_ANON_KEY=
