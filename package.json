{
  "name": "cativa-relatorio-comercial",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Relatório comercial da Cativa Operadora — núcleo compartilhado + app desktop + app mobile",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cativa/desktop",
    "dev:desktop": "npm run dev --workspace @cativa/desktop",
    "dev:mobile": "npm run dev --workspace @cativa/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:desktop": "npm run build --workspace @cativa/desktop",
    "build:mobile": "npm run build --workspace @cativa/mobile",
    "preview:desktop": "npm run preview --workspace @cativa/desktop",
    "preview:mobile": "npm run preview --workspace @cativa/mobile",
    "typecheck": "tsc -b",
    "test": "npm run test --workspace @cativa/nucleo && node --test backend/testes/unidade/*.teste.ts",
    "backend:iniciar": "npx -y supabase@2.122.0 start --workdir backend",
    "backend:parar": "npx -y supabase@2.122.0 stop --workdir backend",
    "backend:status": "npx -y supabase@2.122.0 status --workdir backend",
    "backend:resetar": "npx -y supabase@2.122.0 db reset --workdir backend",
    "backend:testar-banco": "npx -y supabase@2.122.0 test db --workdir backend"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
